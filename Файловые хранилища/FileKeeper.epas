// ДЕЙСТВИЕ: Настройка хранилища файлов
// ============================================================
{@action
Id=F8E7D3C2-A1B0-49E8-9F7D-6CW74A3E2F1D
Target=form
OrigName=FileStore_Setup
Name=Настройка хранилища файлов
Group=FileStore
UI=
  <divider caption="Настройка кнопок хранилища" />
  <grid name="buttons_config" caption="Кнопки хранилища" height="150">
    <list name="action_type" caption="Действие" items="Добавить файл;Открыть хранилище" width="150" required="1"/>
    <component name="button" caption="Кнопка" filter="tdxbutton" required="1"/>
    <list name="show_counter" caption="Счётчик" items="Да;Нет" defaultvalue="Да" width="80" texthint="Показывать количество файлов на кнопке."/>
  </grid>
  <divider caption="Общие настройки" />
  <expr name="DescrExpr" caption="Описание записи в хранилище (выражение)" texthint="Будет подставляться в поле 'Описание записи'"/>
  <divider caption="Путь к папке назначения" />
  <folder name="BaseFolder" caption="Базовая папка" texthint="Выберите основную папку для хранения файлов. Если не указана — создаётся папка &quot;Хранилище файлов&quot; в рабочей директории."/>
  <expr name="SubFolderExpr" caption="Подпапка (выражение)" texthint="Динамическая подпапка. Например: [Год]\[Месяц] или [Контрагент]. Недопустимые символы заменяются на &quot;_&quot;."/>
  <divider caption="Имя файла" />
  <expr name="FileNameExpr" caption="Имя нового файла (выражение)" texthint="Имя файла в хранилище. Недопустимые символы (\ / : * ? &quot; &lt; &gt; |) заменяются на &quot;_&quot;."/>
  <checkbox name="DefaultExt" caption="Исходное расширение в новом имени файла" texthint="Добавлять расширение исходного файла"/>
  <divider caption="Дополнительные настройки" />
  <checkbox name="DelAfterCopy" caption="Удалять исходные файлы" texthint="Удалять файлы после копирования"/>
  <checkbox name="ShowRenameDialog" caption="Диалоговое окно изменения имени файла" texthint="Показывать диалог для изменения имени файла перед добавлением"/>
  <text name="FileTypes" caption="Список расширений файлов" texthint="Например: *.jpg;*.png;*.pdf"/>
  <checkbox name="AllowDuplicates" caption="Разрешить добавление дубликатов" texthint="Позволяет добавлять файлы с одинаковыми именами"/>
  <checkbox name="EditOnAction" caption="Редактировать текущую запись при нажатии" texthint="Автоматически переводить запись в режим редактирования"/>
  <divider caption="Обновление запросов"/>
  <query name="QueryToRefresh" caption="Запрос для обновления" texthint="Выберите запрос для автоматического обновления"/>
  <checkbox name="KeepPos" caption="Сохранять позицию в запросе" defaultvalue="1" texthint="После обновления запроса позиция будет сохранена"/>
  <ifgrid grid="buttons_config">
    <if expr="GetValuesCount(buttons_config, button, GetText(button))>1"
      msg="Кнопка &quot;`GetText(button)`&quot; назначена несколько раз. Каждая кнопка должна быть уникальной."
      focus="button"/>
  </ifgrid>
Description=Универсальная настройка всех кнопок хранилища файлов на форме.<br><br>
<b>📌 Назначение:</b><br>
Добавляет на форму кнопки для работы с файловым хранилищем: добавление файлов к записям и открытие хранилища для просмотра.<br><br>
<b>🔧 Как настроить:</b><br>
1. В таблице <b>"Кнопки хранилища"</b> укажите кнопки и их действия:<br>
   • <b>Добавить файл</b> — кнопка для добавления одного или нескольких файлов<br>
   • <b>Открыть хранилище</b> — кнопка для просмотра всех файлов записи<br>
   • <b>Счётчик</b> — показывать ли количество файлов на кнопке (Да/Нет)<br>
2. Настройте <b>путь к папке назначения</b>:<br>
   • <b>Базовая папка</b> — основная папка для хранения (если не указана — создаётся "Хранилище файлов" в рабочей директории)<br>
   • <b>Подпапка (выражение)</b> — динамическая часть пути, например: [Год]\\[Месяц] или [Контрагент]<br>
3. При необходимости задайте <b>выражение для имени файла</b><br>
4. Настройте дополнительные параметры (удаление исходников, диалог переименования, фильтр расширений и др.)<br><br>
<b>📂 Путь к папке:</b><br>
• Итоговый путь = Базовая папка + Подпапка (выражение)<br>
• Недопустимые символы в пути и подпапке заменяются на "_"<br>
• Пример: Базовая папка = C:\\Files, Подпапка = [Год]\\[Месяц] → C:\\Files\\2026\\Январь\\<br><br>
<b>📝 Имя файла:</b><br>
• Можно задать фиксированное имя или выражение (например, [Номер] + "_" + [Дата])<br>
• Недопустимые символы (\ / : * ? " &lt; &gt; |) заменяются на "_"<br>
• При конфликте имён создаётся уникальное имя: файл.txt → файл(1).txt<br><br>
<b>🛡️ Особенности:</b><br>
• Проверка дубликатов файлов (по имени и дате изменения)<br>
• Автоматическое удаление файлов при отмене редактирования записи<br>
• Обновление выбранного запроса после добавления файлов<br>
• Поддержка представлений формы vtGridOnly<br><br>
<b>💡 Примеры выражений для подпапки:</b><br>
• <code>[Год]</code> → 2026<br>
• <code>[Год] + "\\" + [Месяц]</code> → 2026\\Январь<br>
• <code>[Контрагент]</code> → ООО "Ромашка" (кавычки заменятся на _)<br>
• <code>[ТипДокумента] + "\\" + [Номер]</code> → Договоры\\Д-001<br>
@}

type
  TButtonSetupItem = record
    ActionType: String;
    ButtonName: String;
    ShowCounter: Boolean;
  end;

  TFileStoreSetupData = record
    Fm: TdxForm;
    ButtonItems: array of TButtonSetupItem;
    DescrExpr: String;
    BaseFolder: String;
    SubFolderExpr: String;
    FileNameExpr: String;
    DefaultExt: Integer;
    DelAfterCopy: Integer;
    ShowRenameDialog: Integer;
    FileTypes: String;
    AllowDuplicates: Integer;
    EditOnAction: Integer;
    QueryToRefresh: String;
    KeepPos: Boolean;
    Skip: Boolean;
    OldEditWindowShow: TNotifyEvent;
    OldFormAfterScroll: TNotifyEvent;
    OldBeforePost: TNotifyEvent;
    OldAfterCancel: TNotifyEvent;
  end;

var
  FS_SetupArr: array of TFileStoreSetupData;

// ============================================================
// FORWARD-ОБЪЯВЛЕНИЯ
// ============================================================
procedure FS_OnButtonClick(Sender: TObject); forward;
procedure FS_RefreshQuery(Fm: TdxForm; const QueryName: String; KeepPos: Boolean); forward;
procedure FS_RestoreRecordState(Fm: TdxForm; WasEditing: Boolean); forward;

// ============================================================
// ПОИСК КНОПКИ НА ФОРМЕ
// ============================================================
function FindButtonOnForm(Form: TdxForm; SearchText: String): TdxButton;
var
  i: Integer;
  Component: TComponent;
  Btn: TdxButton;
begin
  Result := nil;
  if (Form = nil) or (SearchText = '') then Exit;
  for i := 0 to Form.ComponentCount - 1 do
  begin
    Component := Form.Components[i];
    if Component is TdxButton then
    begin
      Btn := TdxButton(Component);
      if (Btn.Name = SearchText) or (Btn.Caption = SearchText) then
      begin Result := Btn; Exit; end;
    end;
  end;
end;

// ============================================================
// ПОЛУЧЕНИЕ КОЛИЧЕСТВА ФАЙЛОВ
// ============================================================
function FS_GetFileCount(FmId, ARecId: Integer): Integer;
var
  SQL: String;
  Q: TdxSQLQuery;
begin
  Result := 0;
  if (FmId <= 0) or (ARecId <= 0) then Exit;
  SQL := 'select count(*) as cnt from [file] f where f.[' + FIELD_RECORD_ID + '] = ' + IntToStr(ARecId);
  try
    Q := SQLSelect(SQL);
    try Q.Open; if not Q.EOF then Result := Q.AsI['cnt']; finally Q.Free; end;
  except Result := 0; end;
end;

// ============================================================
// ОБНОВЛЕНИЕ КНОПКИ
// ============================================================
procedure FS_UpdateButtonCaption(Bn: TdxButton; Fm: TdxForm; const BaseCaption: String; ShowCounter: Boolean);
var
  FileCount: Integer;
  BnCap: String;
  p: Integer;
begin
  if Bn = nil then Exit;
  if Fm = nil then Exit;
  BnCap := BaseCaption;
  p := Pos(' (', BnCap);
  if p > 0 then SetLength(BnCap, p - 1);
  if not ShowCounter then begin Bn.Caption := BnCap; Exit; end;
  try
    if Fm.State = dsInsert then FileCount := 0
    else if (Fm.RecId > 0) then FileCount := FS_GetFileCount(Fm.Id, Fm.RecId)
    else FileCount := 0;
  except FileCount := 0; end;
  Bn.Caption := BnCap + ' (' + IntToStr(FileCount) + ')';
end;

// ============================================================
// ПОИСК ЗАПИСИ В МАССИВЕ
// ============================================================
function FS_FindSetupData(AForm: TObject): Integer;
var i: Integer;
begin
  Result := -1;
  for i := High(FS_SetupArr) downto 0 do
    with FS_SetupArr[i] do
      if (AForm = Fm) and not Skip then begin Result := i; Exit; end;
end;

function FS_FindSetupDataByButton(AButton: TObject): Integer;
var i, j: Integer; Btn: TdxButton;
begin
  Result := -1;
  for i := High(FS_SetupArr) downto 0 do
  begin
    if FS_SetupArr[i].Skip then Continue;
    for j := 0 to High(FS_SetupArr[i].ButtonItems) do
    begin
      Btn := FindButtonOnForm(FS_SetupArr[i].Fm, FS_SetupArr[i].ButtonItems[j].ButtonName);
      if Btn = AButton then begin Result := i; Exit; end;
    end;
  end;
end;

function FS_IsAddAction(ActionType: String): Boolean;
begin Result := ActionType = ACTION_ADD_FILE; end;

// ============================================================
// ОБРАБОТЧИКИ СОБЫТИЙ
// ============================================================

procedure FS_RefreshQuery(Fm: TdxForm; const QueryName: String; KeepPos: Boolean);
var Q: TdxQueryGrid; RecId, RecNo: Integer;
begin
  if QueryName = '' then Exit;
  if Fm = nil then Exit;
  Q := Fm.Queries[QueryName];
  if Q = nil then Exit;
  if KeepPos then
  begin
    try RecId := Q.RecId; except RecId := 0; end;
    if RecId = 0 then RecNo := Q.RecNo;
  end;
  Q.Refresh;
  if KeepPos then
  begin
    if RecId > 0 then Q.GotoRecord(RecId)
    else if RecNo > 0 then Q.MoveTo(RecNo);
  end;
end;

procedure FS_OnBeforePost(Sender: TObject);
var n: Integer; Data: TFileStoreSetupData;
begin
  n := FS_FindSetupData(Sender);
  if n < 0 then Exit;
  Data := FS_SetupArr[n];
  if Data.OldBeforePost <> nil then
  try Data.Skip := True; Data.OldBeforePost(Sender); finally Data.Skip := False; end;
end;

procedure FS_OnAfterCancel(Sender: TObject);
var n: Integer; Data: TFileStoreSetupData; FilesTbl, StoreFm: TdxForm;
begin
  n := FS_FindSetupData(Sender);
  if n < 0 then Exit;
  Data := FS_SetupArr[n];
  if Data.OldAfterCancel <> nil then
  try Data.Skip := True; Data.OldAfterCancel(Sender); finally Data.Skip := False; end;
  if Data.Fm.State = dsBrowse then
  begin
    try
      StoreFm := TdxForm.Create(STORE_FORM_NAME);
      try
        StoreFm.OpenRecords('[' + FIELD_FORM_ID + ']=''' + IntToStr(Data.Fm.Id) + '''', nil, False);
        if StoreFm.RecordCount > 0 then
        begin
          FilesTbl := StoreFm.Forms[STORE_FILE_TABLE];
          StoreFm.MoveFirst;
          while not StoreFm.Eof do
          begin
            if StoreFm[FIELD_RECORD_ID] = 0 then
            begin
              FilesTbl.OpenRecord(StoreFm.RecId);
              while FilesTbl.RecordCount > 0 do FilesTbl.Delete;
              StoreFm.Delete;
            end
            else StoreFm.MoveNext;
          end;
        end;
      finally StoreFm.Free; end;
    except end;
  end;
end;

procedure FS_OnAfterScroll(Sender: TObject);
var n, i: Integer; Data: TFileStoreSetupData; Bn: TdxButton; BaseCaption: String;
begin
  n := FS_FindSetupData(Sender);
  if n < 0 then Exit;
  Data := FS_SetupArr[n];
  if Data.OldFormAfterScroll <> nil then
  try Data.Skip := True; Data.OldFormAfterScroll(Sender); finally Data.Skip := False; end;
  for i := 0 to High(Data.ButtonItems) do
  begin
    Bn := FindButtonOnForm(Data.Fm, Data.ButtonItems[i].ButtonName);
    if Bn = nil then Continue;
    BaseCaption := Bn.Caption;
    FS_UpdateButtonCaption(Bn, Data.Fm, BaseCaption, Data.ButtonItems[i].ShowCounter);
  end;
end;

procedure FS_OnEditWindowShow(Sender: TObject);
var n, i: Integer; Data: TFileStoreSetupData; Bn: TdxButton;
begin
  if not (Sender is TEditWindow) then Exit;
  n := FS_FindSetupData(TEditWindow(Sender).Form);
  if n < 0 then Exit;
  Data := FS_SetupArr[n];
  if Data.Fm.ViewType = vtGridOnly then
  begin
    for i := 0 to High(Data.ButtonItems) do
    begin
      Bn := TdxButton(TEditWindow(Sender).FindComponent(Data.ButtonItems[i].ButtonName));
      if Bn = nil then Bn := FindButtonOnForm(Data.Fm, Data.ButtonItems[i].ButtonName);
      if Bn <> nil then
      begin
        Bn.OnClick := @FS_OnButtonClick;
        FS_UpdateButtonCaption(Bn, Data.Fm, Bn.Caption, Data.ButtonItems[i].ShowCounter);
      end;
    end;
  end;
  if Data.OldEditWindowShow <> nil then
  try Data.Skip := True; Data.OldEditWindowShow(Sender); finally Data.Skip := False; end;
  FS_OnAfterScroll(Data.Fm);
end;

// ============================================================
// ВСПОМОГАТЕЛЬНАЯ ПРОЦЕДУРА
// ============================================================
procedure FS_RestoreRecordState(Fm: TdxForm; WasEditing: Boolean);
begin
  if Fm = nil then Exit;
  if not WasEditing then
  begin
    if Fm.State in [dsInsert, dsEdit] then
    begin
      if Fm.Validate then Fm.Post else Fm.Cancel;
    end;
  end;
end;

// ============================================================
// ОБРАБОТЧИКИ КЛИКОВ ПО КНОПКАМ
// ============================================================

procedure FS_OnButtonClick(Sender: TObject);
var
  n, i: Integer;
  Data: TFileStoreSetupData;
  Bn: TdxButton;
  ButtonName: String;
  StoreFm, FilesTbl: TdxForm;
  WasEditingOriginally: Boolean;
  DscrField, DestFolder, UserFlNm: String;
  SrcFlNm, DestFlNm, ResultMsg, DelMsg: String;
  SrcFiles, DestFiles: TStringList;
  CheckResult: TCheckFileResult;
  ProgressBar: TForm;
  AllowDup: Integer;
  EditOnAction: Boolean;
  ActionType: String;
  RenameNewName, DefaultName: String;
begin
  n := FS_FindSetupDataByButton(Sender);
  if n < 0 then Exit;
  Data := FS_SetupArr[n];
  Bn := TdxButton(Sender);
  ButtonName := Bn.Name;

  ActionType := '';
  for i := 0 to High(Data.ButtonItems) do
    if Data.ButtonItems[i].ButtonName = ButtonName then
    begin ActionType := Data.ButtonItems[i].ActionType; Break; end;
  if ActionType = '' then Exit;

  AllowDup := Data.AllowDuplicates;
  EditOnAction := Data.EditOnAction = 1;
  WasEditingOriginally := Data.Fm.State in [dsEdit, dsInsert];

  // ========== ДОБАВИТЬ ФАЙЛ ==========
  if FS_IsAddAction(ActionType) then
  begin
    if Data.Fm.State = dsInsert then
    begin
      if MessageDlg(MSG_WARNING, MSG_SAVE_NEW_RECORD + LineEnding + MSG_SAVE_AND_ADD, mtConfirmation, [mbYes, mbNo]) <> mrYes then Exit;
      if Data.Fm.Validate then begin Data.Fm.Post; Data.Fm.Edit; WasEditingOriginally := True; end else Exit;
    end;
    if EditOnAction and not (Data.Fm.State in [dsInsert, dsEdit]) then Data.Fm.Edit;

    DscrField := VarToStr(EvalExpr(Data.DescrExpr, Data.Fm));
    DestFolder := BuildDestFolder(Data.BaseFolder, Data.SubFolderExpr, Data.Fm);
    UserFlNm := VarToStr(EvalExpr(Data.FileNameExpr, Data.Fm));
    UserFlNm := SanitizeFileName(UserFlNm, False);

    SrcFiles := TStringList.Create;
    with TOpenDialog.Create(nil) do
    begin
      Options := Options + [ofFileMustExist, ofAllowMultiSelect];
      Title := MSG_OPEN_FILE_TITLE;
      Filter := Data.FileTypes;
      if Execute then SrcFiles.AddStrings(Files);
      Free;
    end;

    if SrcFiles.Count = 0 then
    begin
      SrcFiles.Free;
      if Data.QueryToRefresh <> '' then FS_RefreshQuery(Data.Fm, Data.QueryToRefresh, Data.KeepPos);
      FS_RestoreRecordState(Data.Fm, WasEditingOriginally);
      Exit;
    end;

    if not TryForceDirectories(DestFolder) then
    begin SrcFiles.Free; FS_RestoreRecordState(Data.Fm, WasEditingOriginally); Exit; end;

    if (Data.ShowRenameDialog = 1) and (SrcFiles.Count = 1) then
    begin
      if UserFlNm <> '' then
      begin
        if Data.DefaultExt = 1 then DefaultName := UserFlNm + ExtractFileExt(SrcFiles[0])
        else DefaultName := UserFlNm;
      end
      else DefaultName := ExtractFileName(SrcFiles[0]);

      if ShowRenameDialog(DefaultName, RenameNewName) then
      begin
        if RenameNewName <> DefaultName then
        begin
          RenameNewName := SanitizeFileName(RenameNewName, False);
          if Data.DefaultExt = 1 then UserFlNm := ChangeFileExt(RenameNewName, '')
          else UserFlNm := RenameNewName;
        end;
      end
      else
      begin
        SrcFiles.Free;
        if Data.QueryToRefresh <> '' then FS_RefreshQuery(Data.Fm, Data.QueryToRefresh, Data.KeepPos);
        FS_RestoreRecordState(Data.Fm, WasEditingOriginally);
        Exit;
      end;
    end;

    ResultMsg := ''; DelMsg := '';
    StoreFm := CreateStore_Fm;
    FilesTbl := StoreFm.Forms[STORE_FILE_TABLE];
    DestFiles := TStringList.Create;
    ProgressBar := nil;

    try
      ProgressBar := ShowProgress(MSG_PROGRESS_COPY, '', 300, 200);
      StoreFm.OpenRecords('[' + FIELD_FORM_ID + ']=''' + IntToStr(Data.Fm.Id) + ''' & [' + FIELD_RECORD_ID + ']=''' + IntToStr(Data.Fm.RecId) + '''', nil, False);

      for i := SrcFiles.Count - 1 downto 0 do
      begin
        SrcFlNm := SrcFiles[i];
        if UserFlNm <> '' then
        begin
          if Data.DefaultExt = 1 then DestFlNm := DestFolder + UserFlNm + ExtractFileExt(SrcFlNm)
          else DestFlNm := DestFolder + UserFlNm;
        end
        else DestFlNm := DestFolder + ExtractFileName(SrcFlNm);

        CheckResult := CheckFile(FilesTbl, SrcFlNm, AllowDup);
        case CheckResult of
          cfSrcNotFound: ResultMsg := ResultMsg + LE2 + MSG_FILE_NOT_FOUND + SrcFlNm;
          cfSrcOlder: ResultMsg := ResultMsg + LE2 + MSG_FILE_SKIPPED_OLDER + SrcFlNm + MSG_HINT_OLDER;
          cfSrcSame: ResultMsg := ResultMsg + LE2 + MSG_FILE_SKIPPED_SAME + SrcFlNm + MSG_HINT_SAME;
        end;
        if not (CheckResult in [cfSrcNew, cfSrcNewer]) then begin SrcFiles.Delete(i); Continue; end;
        if CheckResult = cfSrcNew then DestFlNm := MakeUniqueFileName(DestFlNm);

        if FileExists(DestFlNm) and not CanWriteFile(DestFlNm) then
          ResultMsg := ResultMsg + LE2 + MSG_CANNOT_REPLACE + DestFlNm + MSG_FILE_BUSY
        else
          try MyCopyFile(SrcFlNm, DestFlNm); DestFiles.Insert(0, DestFlNm);
          except ResultMsg := ResultMsg + LE2 + MSG_COPY_ERROR + SrcFlNm + ' в ' + DestFlNm + '. ' + ExceptionParam; end;
      end;

      if DestFiles.Count > 0 then
      begin
        if StoreFm.RecordCount = 0 then
        begin
          StoreFm.Append;
          SafeSetField(StoreFm, FIELD_FORM_ID, Data.Fm.Id);
          SafeSetField(StoreFm, FIELD_RECORD_ID, Data.Fm.RecId);
          SafeSetField(StoreFm, FIELD_FORM, Data.Fm.FormCaption);
          SafeSetField(StoreFm, FIELD_DESCRIPTION, DscrField);
        end
        else StoreFm.Edit;
        for i := 0 to SrcFiles.Count - 1 do CreateRecordInTable(FilesTbl, SrcFiles[i], DestFiles[i], AllowDup);
        StoreFm.Post;
        if Data.DelAfterCopy = 1 then
          for i := SrcFiles.Count - 1 downto 0 do
          begin
            SrcFlNm := SrcFiles[i];
            if not DeleteFile(SrcFlNm) then DelMsg := DelMsg + LE2 + MSG_DELETE_ERROR + SrcFlNm;
          end;
      end;

      ProgressBar.Free; ProgressBar := nil;
      if ResultMsg <> '' then MsgBox(MSG_CAPTION, MSG_COPY_RESULT + ResultMsg);
      if DelMsg <> '' then MsgBox(MSG_CAPTION, MSG_DELETE_RESULT + DelMsg);
    finally
      if ProgressBar <> nil then ProgressBar.Free;
      StoreFm.Free; SrcFiles.Free; DestFiles.Free;
    end;

    FS_OnAfterScroll(Data.Fm);
    if Data.QueryToRefresh <> '' then FS_RefreshQuery(Data.Fm, Data.QueryToRefresh, Data.KeepPos);
    FS_RestoreRecordState(Data.Fm, WasEditingOriginally);
  end

  // ========== ОТКРЫТЬ ХРАНИЛИЩЕ ==========
  else
  begin
    if Data.Fm.State = dsInsert then
    begin
      if MessageDlg(MSG_WARNING, MSG_SAVE_BEFORE_OPEN + LineEnding + MSG_SAVE_AND_OPEN, mtConfirmation, [mbYes, mbNo]) <> mrYes then Exit;
      if Data.Fm.Validate then begin Data.Fm.Post; Data.Fm.Edit; WasEditingOriginally := True; end else Exit;
    end;
    if EditOnAction and not (Data.Fm.State in [dsInsert, dsEdit]) then Data.Fm.Edit;

    StoreFm := CreateStore_Fm;
    StoreFm.OpenRecords('[' + FIELD_FORM_ID + ']=''' + IntToStr(Data.Fm.Id) + ''' & [' + FIELD_RECORD_ID + ']=''' + IntToStr(Data.Fm.RecId) + '''', nil, False);

    if StoreFm.RecordCount = 0 then
    begin
      StoreFm.Append;
      SafeSetField(StoreFm, FIELD_FORM_ID, Data.Fm.Id);
      SafeSetField(StoreFm, FIELD_RECORD_ID, Data.Fm.RecId);
      SafeSetField(StoreFm, FIELD_FORM, Data.Fm.FormCaption);
    end
    else StoreFm.Edit;

    try
      StoreFm.EditWindow.Buttons.ShowButtons := [pbClose];
      StoreFm.EditWindow.ShowModal;
      StoreFm.Post;
      FS_OnAfterScroll(Data.Fm);
      if Data.QueryToRefresh <> '' then FS_RefreshQuery(Data.Fm, Data.QueryToRefresh, Data.KeepPos);
      FS_RestoreRecordState(Data.Fm, WasEditingOriginally);
    finally StoreFm.Free; end;
  end;
end;

// ============================================================
// ГЛАВНАЯ ФУНКЦИЯ НАСТРОЙКИ
// ============================================================

function FileStore_Setup(ButtonConfig: TVariantArray2d; DescrExpr, BaseFolder, SubFolderExpr, FileNameExpr: String;
  DefaultExt, DelAfterCopy, ShowRenameDialog: Integer; FileTypes: String;
  AllowDuplicates, EditOnAction: Integer; QueryToRefresh: String; KeepPos: Integer): Boolean;
var
  Data: TFileStoreSetupData;
  n, i: Integer;
  Bn: TdxButton;
  ShowCounterVal: string;
begin
  Result := True;

  Data.Fm := Self;
  Data.DescrExpr := DescrExpr;
  Data.BaseFolder := BaseFolder;
  Data.SubFolderExpr := SubFolderExpr;
  Data.FileNameExpr := FileNameExpr;
  Data.DefaultExt := DefaultExt;
  Data.DelAfterCopy := DelAfterCopy;
  Data.ShowRenameDialog := ShowRenameDialog;
  Data.FileTypes := FileTypes;
  Data.AllowDuplicates := AllowDuplicates;
  Data.EditOnAction := EditOnAction;
  Data.QueryToRefresh := QueryToRefresh;
  Data.KeepPos := KeepPos = 1;
  Data.Skip := False;

  SetLength(Data.ButtonItems, Length(ButtonConfig));
  for i := 0 to High(ButtonConfig) do
  begin
    Data.ButtonItems[i].ActionType := ButtonConfig[i][0];
    Data.ButtonItems[i].ButtonName := ButtonConfig[i][1];
    ShowCounterVal := VarToStr(ButtonConfig[i][2]);
    Data.ButtonItems[i].ShowCounter := (ShowCounterVal <> 'Нет');

    Bn := FindButtonOnForm(Self, ButtonConfig[i][1]);
    if Bn <> nil then
    begin
      Bn.OnClick := @FS_OnButtonClick;
      FS_UpdateButtonCaption(Bn, Self, Bn.Caption, Data.ButtonItems[i].ShowCounter);
    end;
  end;

  Data.OldFormAfterScroll := Self.OnAfterScroll;
  Data.OldBeforePost := Self.OnBeforePost;
  Data.OldAfterCancel := Self.OnAfterCancel;

  Self.OnAfterScroll := @FS_OnAfterScroll;
  Self.OnAfterCancel := @FS_OnAfterCancel;
  if QueryToRefresh <> '' then Self.OnBeforePost := @FS_OnBeforePost;
  if Self.ViewType = vtGridOnly then
  begin
    Data.OldEditWindowShow := Self.EditWindow.OnShow;
    Self.EditWindow.OnShow := @FS_OnEditWindowShow;
  end;

  n := Length(FS_SetupArr);
  SetLength(FS_SetupArr, n + 1);
  FS_SetupArr[n] := Data;
end;

// ============================================================
// ИНИЦИАЛИЗАЦИЯ / ДЕИНИЦИАЛИЗАЦИЯ
// ============================================================
procedure Init;
begin
  SetLength(FS_SetupArr, 0);
end;

procedure Done;
begin
  SetLength(FS_SetupArr, 0);
end;

// ============================================================
// ТОЧКА ВХОДА
// ============================================================
begin
  Init;
end.
