// ============================================
// ★ ФУНКЦИЯ: ЗАМЕНА НЕДОПУСТИМЫХ СИМВОЛОВ ★
// ============================================
function SanitizeFileName(const AStr: string; IsPath: Boolean): string;
var
  i: Integer;
  Ch: Char;
  InvalidChars: string;
begin
  Result := '';
  if AStr = '' then Exit;

  if IsPath then
    InvalidChars := INVALID_PATH_CHARS
  else
    InvalidChars := INVALID_FILE_CHARS;

  for i := 1 to Length(AStr) do
  begin
    Ch := AStr[i];
    if Ord(Ch) < 32 then Continue;
    if Pos(Ch, InvalidChars) > 0 then
      Result := Result + '_'
    else
      Result := Result + Ch;
  end;
end;

// ============================================
// ★ ФУНКЦИЯ: ПОЛУЧЕНИЕ ПОЛНОГО ПУТИ НАЗНАЧЕНИЯ ★
// ============================================
function BuildDestFolder(const BaseFolder, SubFolderExpr: string; Fm: TdxForm): string;
var
  SubFolder: string;
begin
  if BaseFolder <> '' then
    Result := BaseFolder
  else
    Result := GetCurrentDir + '\' + DEFAULT_STORAGE_FOLDER;

  Result := SanitizeFileName(Result, True);
  Result := IncludeTrailingPathDelimiter(Result);

  if Trim(SubFolderExpr) <> '' then
  begin
    try
      SubFolder := VarToStr(EvalExpr(SubFolderExpr, Fm));
    except
      SubFolder := '';
    end;

    if Trim(SubFolder) <> '' then
    begin
      SubFolder := SanitizeFileName(SubFolder, True);
      Result := Result + SubFolder;
      Result := IncludeTrailingPathDelimiter(Result);
    end;
  end;
end;

// ============================================
// ★ ФУНКЦИЯ: БЕЗОПАСНАЯ УСТАНОВКА ПОЛЯ ФОРМЫ ★
// ============================================
procedure SafeSetField(Fm: TdxForm; const FieldName: string; const Value: Variant);
begin
  try
    Fm.Fields[FieldName] := Value;
  except
  end;
end;

// ============================================
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// ============================================

function ShowProgress(const AMsg, AImgStr: String; W, H: Integer): TForm;
var
  Img: TdxImage;
begin
  Img := nil;
  Result := TForm.Create(Application);
  with Result do
  begin
    BorderStyle := bsNone;
    if W = 0 then W := 300;
    if H = 0 then H := 200;
    Width := Scale96ToScreen(W);
    Height := Scale96ToScreen(H);
    Font.Name := 'Verdana';
    Font.Size := 10;
    Position := poMainFormCenter;
    FormStyle := fsStayOnTop;
    Color := clWhite;
  end;
  with TShape.Create(Result) do
  begin
    Parent := Result;
    Align := alClient;
    Brush.Color := Result.Color;
  end;
  if AImgStr <> '' then
  begin
    Img := TdxImage.Create(Result);
    with Img do
    begin
      Parent := Result;
      LoadFromStringBase64(AImgStr);
      Width := Bitmap.Width;
      Height := Bitmap.Height;
      Left := Result.Width div 2 - Width div 2;
      Top := Result.Height div 2 - Height div 2;
      if AMsg <> '' then Top := Top - Round(Abs(Result.Font.Height) * 2);
    end;
  end;
  if AMsg <> '' then
  begin
    with TLabel.Create(Result) do
    begin
      Parent := Result;
      AutoSize := False;
      WordWrap := True;
      Alignment := taCenter;
      if Img = nil then
      begin
        Align := alClient;
        BorderSpacing.Around := Scale96ToScreen(4);
        Layout := tlCenter;
      end
      else
      begin
        Left := Scale96ToScreen(4);
        Top := Img.Top + Img.Height + Round(Abs(Result.Font.Height));
        Width := Result.Width - Scale96ToScreen(8);
        Height := Result.Height - Top - Scale96ToScreen(4);
      end;
      Caption := AMsg;
    end;
  end;
  Result.Show;
  Application.ProcessMessages;
end;

function CreateStore_Fm: TdxForm;
var
  Btn: TdxButton;
  PageCtrl: TdxPageControl;
begin
  Result := TdxForm.Create(STORE_FORM_NAME);
  Btn := TdxButton(Result.FindComponent(STORE_BUTTON_DISABLE));
  if Btn <> nil then Btn.Enabled := False;
  PageCtrl := TdxPageControl(Result.FindComponent(STORE_PAGECTRL));
  if (PageCtrl <> nil) and (PageCtrl.PageCount > 1) then
    PageCtrl.Pages[1].TabVisible := False;
end;

function TryForceDirectories(const DestFolder: String): Boolean;
begin
  Result := ForceDirectories(DestFolder);
  if not Result then
    MessageDlg(MSG_CAPTION, MSG_ERROR_FOLDER +
      LineEnding + LineEnding + DestFolder + LineEnding + LineEnding +
      MSG_HINT_FOLDER, mtError, [mbAbort]);
end;

function MakeUniqueFileName(DestFileName: String): String;
var
  i: Integer;
  FlNm, FlExt: String;
begin
  Result := DestFileName;
  if not FileExists(DestFileName) then Exit;
  FlExt := ExtractFileExt(DestFileName);
  FlNm := ChangeFileExt(DestFileName, '');
  i := 1;
  while True do
  begin
    Result := FlNm + '(' + IntToStr(i) + ')' + FlExt;
    if not FileExists(Result) then Break else Inc(i);
  end;
end;

function CanWriteFile(const FileName: String): Boolean;
begin
  try
    TFileStream.Create(FileName, fmOpenWrite).Free;
    Result := True;
  except
    Result := False;
  end;
end;

procedure MyCopyFile(const SrcFileName, DestFileName: String);
var
  SrcSt, DestSt: TFileStream;
  Buf: String;
  BufSize, ReadBytes: Integer;
  FileChanged: LongInt;
begin
  ForceDirectories(ExtractFilePath(DestFileName));
  SrcSt := nil; DestSt := nil;
  FileChanged := FileAge(SrcFileName);
  BufSize := 1024 * 1024;
  SetLength(Buf, BufSize);
  try
    SrcSt := TFileStream.Create(SrcFileName, fmOpenRead + fmShareDenyNone);
    DestSt := TFileStream.Create(DestFileName, fmCreate);
    repeat
      ReadBytes := SrcSt.Read(Buf, BufSize);
      DestSt.Write(Buf, ReadBytes);
    until ReadBytes < BufSize;
  finally
    if SrcSt <> nil then SrcSt.Free;
    if DestSt <> nil then DestSt.Free;
  end;
  FileSetDate(DestFileName, FileChanged);
end;

type
  TCheckFileResult = (cfSrcNotFound, cfSrcOlder, cfSrcSame, cfSrcNewer, cfSrcNew);

function FindSourceFile(FilesTbl: TdxForm; const FileNameOnly, FullPath: String; AllowDuplicates: Boolean): Boolean;
var
  Src: String;
begin
  if AllowDuplicates then begin Result := False; Exit; end;
  Result := False;
  with FilesTbl do
  begin
    DisableScrollEvents;
    DisableControls;
    try
      MoveFirst;
      while not Eof do
      begin
        Src := AsS[FIELD_SOURCE];
        if (Utf8CompareText(ExtractFileName(Src), FileNameOnly) = 0) or
           (Utf8CompareText(Src, FullPath) = 0) then
        begin Result := True; Exit; end;
        MoveNext;
      end;
    finally
      EnableControls;
      EnableScrollEvents;
    end;
  end;
end;

function CheckFile(FilesTbl: TdxForm; const SrcFileName: String; AllowDuplicates: Integer): TCheckFileResult;
var
  SrcChanged, DestChanged: Longint;
  DestFileName: String;
begin
  Result := cfSrcNew;
  SrcChanged := FileAge(SrcFileName);
  if SrcChanged = -1 then
    Result := cfSrcNotFound
  else if FindSourceFile(FilesTbl, ExtractFileName(SrcFileName), SrcFileName, AllowDuplicates = 1) then
  begin
    DestFileName := FilesTbl.Files[FIELD_FILE].SourceFileName;
    DestChanged := FileAge(DestFileName);
    if DestChanged = -1 then
    else if SrcChanged < DestChanged then Result := cfSrcOlder
    else if SrcChanged = DestChanged then Result := cfSrcSame
    else Result := cfSrcNewer
  end;
end;

procedure CreateRecordInTable(FilesTbl: TdxForm; SrcFileName, DestFileName: String; AllowDuplicates: Integer);
var
  FileComp: TdxFile;
  DT: TDateTime;
  FileTime: LongInt;
begin
  with FilesTbl do
  begin
    FileComp := Files[FIELD_FILE];
    if not FindSourceFile(FilesTbl, ExtractFileName(SrcFileName), SrcFileName, AllowDuplicates = 1) then
      Append
    else
      Edit;
    FileTime := FileAge(DestFileName);
    if FileTime <> -1 then DT := FileDateToDateTime(FileTime) else DT := Now;
    Fields[FIELD_DATE] := DT;
    Fields[FIELD_TIME] := DT;
    FileComp.LoadFromFile(DestFileName);
    Fields[FIELD_SOURCE] := SrcFileName;
    Fields[FIELD_FOLDER_PATH] := ExtractFilePath(DestFileName);
    Fields[FIELD_FILE_NAME] := ExtractFileName(DestFileName);
    case FileComp.StorageType of
      0: Fields[FIELD_STORAGE_METHOD] := STORAGE_DB;
      1: Fields[FIELD_STORAGE_METHOD] := STORAGE_FOLDER;
      2: Fields[FIELD_STORAGE_METHOD] := STORAGE_LINK;
    end;
    Post;
  end;
end;

// ============================================================
// ФУНКЦИЯ: ДИАЛОГ ИЗМЕНЕНИЯ ИМЕНИ ФАЙЛА
// ============================================================
function ShowRenameDialog(const DefaultFileName: String; var NewFileName: String): Boolean;
var
  Frm: TForm;
  Lbl: TLabel;
  Edt: TEdit;
  BtnOk, BtnCancel: TButton;
begin
  Result := False;
  NewFileName := DefaultFileName;
  Frm := TForm.Create(Application);
  try
    Frm.Caption := MSG_RENAME_CAPTION;
    Frm.Width := 380; Frm.Height := 130;
    Frm.Position := poMainFormCenter;
    Frm.BorderIcons := [biSystemMenu];
    Frm.BorderStyle := bsDialog;
    Lbl := TLabel.Create(Frm); Lbl.Parent := Frm;
    Lbl.Left := 12; Lbl.Top := 12; Lbl.Width := 350;
    Lbl.Caption := MSG_RENAME_PROMPT;
    Edt := TEdit.Create(Frm); Edt.Parent := Frm;
    Edt.Left := 12; Edt.Top := 34; Edt.Width := 350; Edt.Height := 26;
    Edt.Text := DefaultFileName; Edt.SelectAll;
    BtnOk := TButton.Create(Frm); BtnOk.Parent := Frm;
    BtnOk.Caption := 'OK'; BtnOk.Left := 198; BtnOk.Top := 72;
    BtnOk.Width := 80; BtnOk.ModalResult := mrOk;
    BtnCancel := TButton.Create(Frm); BtnCancel.Parent := Frm;
    BtnCancel.Caption := 'Отмена'; BtnCancel.Left := 288; BtnCancel.Top := 72;
    BtnCancel.Width := 80; BtnCancel.ModalResult := mrCancel;
    if Frm.ShowModal = mrOk then
    begin
      NewFileName := Trim(Edt.Text);
      if NewFileName <> '' then Result := True
      else MessageDlg(MSG_WARNING, MSG_RENAME_EMPTY, mtWarning, [mbOk]);
    end;
  finally
    Frm.Free;
  end;
end;

